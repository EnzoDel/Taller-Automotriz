PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=DB_TallerAutomotriz
DB_USER=postgres
DB_PASSWORD=
DATABASE_URL=
DB_SSL=false
# Certificado raíz PEM de la base de datos. En el proveedor puede usarse \n para saltos de línea.
DB_SSL_CA=

# En producción: origen HTTPS del frontend, sin barra final. Varios orígenes se separan por comas.
FRONTEND_ORIGINS=

# Genera una clave aleatoria para producción. En desarrollo se crea una temporal si se deja vacía.
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Meta WhatsApp Cloud API (mantener estos valores en backend/.env, nunca versionarlos)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es

# SRI (no guardar el certificado ni sus contraseñas en el repositorio)
SRI_ENVIRONMENT=test
SRI_RUC=
SRI_BUSINESS_NAME=
SRI_HEAD_OFFICE_ADDRESS=
SRI_ESTABLISHMENT_CODE=001
SRI_EMISSION_POINT=001
SRI_ACCOUNTING_REQUIRED=
SRI_RECEIVE_URL=
SRI_AUTHORIZATION_URL=
SRI_CERTIFICATE_PATH=
SRI_CERTIFICATE_PASSWORD=

# Swagger
SWAGGER_TITLE=Taller Automotriz API
SWAGGER_DESCRIPTION=API para gestión del taller automotriz
SWAGGER_VERSION=1.0.0
